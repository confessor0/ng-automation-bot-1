# ============================================================================
# FYERS API CREDENTIALS
# ============================================================================
FYERS_APP_ID=your_app_id_here
FYERS_SECRET_ID=your_secret_id_here
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html

# ============================================================================
# CURRENT SESSION TOKENS (Managed by Bot)
# ============================================================================
FYERS_ACCESS_TOKEN=

# ============================================================================
# BOT CONFIGURATION
# ============================================================================
# Set to 'true' to only fetch data on manual "Refresh" click (saves API quota)
# Set to 'false' for continuous 60-second polling
ON_DEMAND_MODE=true

# Dashboard Port
PORT=5055

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Mailjet trend notifications (credentials can also be managed in Admin)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
